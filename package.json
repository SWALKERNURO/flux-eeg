{
  "name": "flux-eeg",
  "version": "0.8.0",
  "description": "Local-first EEG 1/f analysis, guided experiments, and study workflows.",
  "author": "Flux EEG",
  "private": true,
  "packageManager": "npm@11.17.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "desktop": "npm run build:web && electron .",
    "desktop:test": "npm run build:web && electron . --smoke-test",
    "desktop:dir": "npm run build:web && electron-builder --dir",
    "desktop:build": "npm run build:web && electron-builder --win nsis",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "org.fluxeeg.desktop",
    "productName": "Flux EEG",
    "asar": true,
    "directories": {
      "output": "installer-output"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/client/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.png",
      "artifactName": "Flux-EEG-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flux EEG",
      "deleteAppDataOnUninstall": false
    }
  }
}
